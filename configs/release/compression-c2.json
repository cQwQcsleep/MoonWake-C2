[
  {
    "kernelSource": {
      "device": "ruby",
      "vendor": "xiaomi",
      "name": "MoonWake-2.7.0-C2",
      "defconfig": "ruby_defconfig",
      "extraConfig": "vendor/bbr.config vendor/noop.config vendor/kernelsu.config vendor/susfs.config vendor/kernelpatch.config vendor/zram_compress.config vendor/hybridmount.config vendor/gaming_balanced.config vendor/compression.config vendor/logging-hm.config",
      "repo": "https://github.com/cQwQcsleep/MoonWake-C2",
      "branch": "c2"
    },
    "output_image": "Image.gz-dtb",
    "additional_script_link": "https://raw.githubusercontent.com/cQwQcsleep/MoonWake-C2/c2/ci/version-mwk.sh",
    "additional_post_script_link": "disabled",
    "kp": {
      "use": false,
      "kpimg_link": ""
    },
    "kernelsu": {
      "enable": true,
      "setupLink": "https://raw.githubusercontent.com/cQwQcsleep/MoonWake-C2/c2/ci/ksun-moonwake.sh",
      "setupArg": "legacy-susfs-v2-susmount",
      "setupName": "KernelSU-Next",
      "needPatch": false,
      "susfsLink": ""
    },
    "toolchains": [
      {
        "repo": "https://gitlab.com/DR-KernelArchive/clang/r563880.git",
        "branch": "main",
        "name": "clang-AOSP",
        "binPath": [
          "/bin"
        ]
      }
    ],
    "ccache": false,
    "params": {
      "ARCH": "arm64",
      "CC": "clang-AOSP/bin/clang",
      "KCFLAGS": "-O3 -march=armv8.2-a+crypto+fp16+dotprod -mcpu=cortex-a78 -mtune=cortex-a78",
      "build_out": "Image.gz-dtb",
      "externalCommand": {
        "KBUILD_BUILD_HOST": "perfc.org",
        "KBUILD_BUILD_USER": "rainyxeon",
        "CROSS_COMPILE": "clang-AOSP/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "clang-AOSP/bin/arm-linux-gnueabi-",
        "LD": "clang-AOSP/bin/ld.lld",
        "LLVM": "1",
        "LLVM_IAS": "1",
        "AR": "clang-AOSP/bin/llvm-ar",
        "NM": "clang-AOSP/bin/llvm-nm",
        "OBJCOPY": "clang-AOSP/bin/llvm-objcopy",
        "OBJDUMP": "clang-AOSP/bin/llvm-objdump",
        "READELF": "clang-AOSP/bin/llvm-readelf",
        "OBJSIZE": "clang-AOSP/bin/llvm-size",
        "STRIP": "clang-AOSP/bin/llvm-strip",
        "LDGOLD": "clang-AOSP/bin/aarch64-linux-gnu-ld.gold",
        "LLVM_AR": "clang-AOSP/bin/llvm-ar",
        "LLVM_DIS": "clang-AOSP/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "repo": "https://github.com/DXRN-MoonWake/AnyKernel3",
      "branch": "ruby"
    }
  }
