# Game-v1: balanced gaming kernel
# Memory: MGLRU (MoonWake backport) + ZRAM writeback
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
CONFIG_ZRAM_WRITEBACK=y
# I/O: UFS blk-mq, HPB disabled
CONFIG_SCSI_MQ_DEFAULT=y
CONFIG_MQ_IOSCHED_DEADLINE=y
# CONFIG_SCSI_UFS_HPB is not set
# CONFIG_SCSI_SKHPB is not set
# Overhead: release build without KFENCE / stack zeroing
# CONFIG_KFENCE is not set
# CONFIG_INIT_STACK_ALL_ZERO is not set
# MTK gaming framework
CONFIG_MTK_PERFMGR_TOUCH_BOOST=y
CONFIG_MTK_FPSGO_V3=y
