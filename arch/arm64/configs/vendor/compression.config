# F2FS transparent compression
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_COMPRESSION_ALL=y
CONFIG_F2FS_FS_LZO_RLE=y
CONFIG_F2FS_FS_LZ4K=y
CONFIG_F2FS_FS_LZ4KD=y
CONFIG_F2FS_FS_LZ4K_OPLUS=y
CONFIG_F2FS_FS_ZSTDN=y

# ZRAM crypto backends
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_CRYPTO_ZSTDN=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_ZRAM_WRITEBACK=y
