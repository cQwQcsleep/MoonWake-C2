# MoonWake C2P perf profile (must be applied AFTER all other fragments)

# Gate for the MTK ANDROID_DEFAULT_SETTING select surgery, the
# hybridmount_ symbol filter and the swappiness default.
CONFIG_MWK_PERF_PROFILE=y

# KALLSYMS_ALL must stay on: KernelSU-Next symbol resolving and susfs
# walk data symbols at init, and C2 ships it =y.
CONFIG_KALLSYMS_ALL=y

# Keep /proc/config.gz for on-device debugging.
CONFIG_IKCONFIG_PROC=y

# KPTI stays ON.  ARM64_SW_TTBR0_PAN=y shares the reserved-TTBR0
# trampoline with KPTI in this tree; turning KPTI off changes ASID
# width and the uaccess page-table state versus C2.
CONFIG_UNMAP_KERNEL_AT_EL0=y

# BBR pacing queues
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
