# MoonWake C2P perf profile (must be applied AFTER all other fragments)

# Gate for the MTK ANDROID_DEFAULT_SETTING select surgery
CONFIG_MWK_PERF_PROFILE=y

# Symbol exposure / size
# CONFIG_KALLSYMS_ALL is not set

# No runtime /proc/config.gz
# CONFIG_IKCONFIG_PROC is not set

# KPTI off (Cortex-A78/A55 are not affected by the Meltdown class of issues)
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set

# F2FS: no forced compression on every new file, no debug statistics
# CONFIG_F2FS_FS_COMPRESSION_ALL is not set
# CONFIG_F2FS_STAT_FS is not set

# zram: no userspace backing_dev exists, writeback is dead weight
# CONFIG_ZRAM_WRITEBACK is not set

# BBR pacing queues
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
