# MoonWake C2P perf profile (must be applied AFTER all other fragments)

# Gate for the MTK ANDROID_DEFAULT_SETTING select surgery and for
# hiding the hybridmount_ symbols in kallsyms.
CONFIG_MWK_PERF_PROFILE=y

# Symbol exposure / size
# CONFIG_KALLSYMS_ALL is not set

# No runtime /proc/config.gz
# CONFIG_IKCONFIG_PROC is not set

# KPTI off (Cortex-A78/A55 are not affected by the Meltdown class of issues)
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set

# BBR pacing queues
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# kernel.dmesg_restrict defaults to 1
CONFIG_SECURITY_DMESG_RESTRICT=y

# zram: per-page algorithm tracking + manual recompression
CONFIG_ZRAM_MULTI_COMP=y
